---
const stats = [
  { value: '+3',    label: 'سنوات خبرة' },
  { value: '+20',   label: 'مشروع منجز' },
  { value: '100%',  label: 'التزام بالمواعيد' },
  { value: 'KSA',   label: 'تخصص السوق السعودي' },
];
---

<section class="border-y border-border bg-navy/[0.02] py-8">
  <div class="container-site">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {stats.map((stat, i) => (
        <div class={`flex flex-col items-center gap-1 text-center ${i > 0 ? 'md:border-r md:border-border md:pr-8' : ''}`}>
          <span class="text-3xl font-light text-navy tracking-tight">{stat.value}</span>
          <span class="text-xs font-light text-ink/50 tracking-widest">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
