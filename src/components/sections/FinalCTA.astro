---
---

<section class="section-padding bg-navy text-cream relative overflow-hidden">

  <!-- Background decorations -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <svg class="absolute -bottom-20 -left-20 opacity-[0.08] w-[400px] h-[400px]" viewBox="0 0 100 100">
      <polygon points="50,2 98,50 50,98 2,50" fill="none" stroke="#FAFAF9" stroke-width="2"/>
    </svg>
    <svg class="absolute -top-10 -right-10 opacity-[0.05] w-[300px] h-[300px]" viewBox="0 0 100 100">
      <polygon points="50,2 98,50 50,98 2,50" fill="#FAFAF9"/>
    </svg>
  </div>

  <div class="container-site relative z-10 text-center">

    <!-- Label -->
    <div class="flex items-center justify-center gap-4 mb-8">
      <div class="w-8 h-px bg-teal-light opacity-60"></div>
      <span class="text-teal-light text-xs font-light tracking-widest uppercase">ابدأ الآن</span>
      <div class="w-8 h-px bg-teal-light opacity-60"></div>
    </div>

    <!-- Headline -->
    <h2 class="text-4xl md:text-6xl font-light text-cream leading-tight mb-6 text-balance max-w-2xl mx-auto">
      مشروعك يستحق
      <span class="text-teal-light"> شريكاً حقيقياً</span>
    </h2>

    <!-- Sub -->
    <p class="text-lg text-cream/60 font-light leading-relaxed mb-10 max-w-xl mx-auto">
      استشارة مجانية 30 دقيقة — نحدد فيها احتياجاتك ونرسم خطة واضحة لمشروعك.
      بدون التزام، بدون ضغط.
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a
        href="/contact"
        class="inline-flex items-center px-8 py-4 bg-cream text-navy text-sm font-light tracking-widest hover:bg-teal-light transition-colors duration-200"
      >
        احجز استشارة مجانية
      </a>
      <a
        href="https://wa.me/966550957393"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 border border-cream/30 text-cream text-sm font-light tracking-widest hover:border-cream/60 transition-colors duration-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        تواصل عبر واتساب
      </a>
    </div>

    <!-- Trust note -->
    <p class="mt-8 text-xs text-cream/30 font-light tracking-widest">
      يرد على الاستفسارات خلال 24 ساعة · السعودية العربية
    </p>

  </div>
</section>
