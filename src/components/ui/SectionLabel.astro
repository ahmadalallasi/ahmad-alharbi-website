---
interface Props {
  label: string;
  align?: 'start' | 'center';
  class?: string;
}

const { label, align = 'start', class: cls = '' } = Astro.props;

const alignClass = align === 'center' ? 'justify-center' : 'justify-start';
---

<div class={`flex items-center gap-4 ${alignClass} ${cls}`}>
  <div class="h-px w-8 bg-teal flex-shrink-0"></div>
  <span class="text-teal text-xs font-light tracking-widest uppercase whitespace-nowrap">
    {label}
  </span>
  <div class="h-px flex-1 bg-border"></div>
</div>
