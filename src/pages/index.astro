---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import ServicesGrid from '../components/sections/ServicesGrid.astro';
import ProcessTimeline from '../components/sections/ProcessTimeline.astro';
import FeaturedWork from '../components/sections/FeaturedWork.astro';
import Testimonials from '../components/sections/Testimonials.tsx';
import LatestBlog from '../components/sections/LatestBlog.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
---

<BaseLayout
  title="Ahmad Alharbi — خبير التسويق الإلكتروني والتطوير التقني"
  description="مختص تسويق رقمي سعودي يبني حلولاً تسويقية وتقنية حقيقية تُنمّي مبيعاتك وتُوفّر وقتك."
  lang="ar"
  dir="rtl"
>
  <Hero />
  <TrustBar />
  <ServicesGrid />
  <ProcessTimeline />
  <FeaturedWork />
  <Testimonials client:visible />
  <LatestBlog />
  <FinalCTA />
</BaseLayout>
