---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="عن أحمد"
  description="نبذة عن أحمد، مختص تسويق رقمي مع خبرة في التطوير التقني."
  lang="ar"
  dir="rtl"
>
  <section class="section-padding">
    <div class="container-site max-w-3xl">
      <SectionLabel label="عن أحمد" />
      <h1 class="text-4xl md:text-5xl font-light text-ink mt-6 mb-8 leading-tight">
        خبير واحد <span class="text-navy">مسؤول عن نتائجك</span>
      </h1>

      <div class="space-y-6 text-ink/70 font-light leading-loose">
        <p>
          أنا أحمد، مختص تسويق رقمي سعودي مع خبرة في التطوير التقني. أعمل مع التجار وأصحاب المشاريع في السوق السعودي لبناء حلول رقمية حقيقية تُنمّي مبيعاتهم وتُوفّر وقتهم.
        </p>
        <p>
          خلفيتي تجمع بين <strong class="text-ink">التسويق الرقمي</strong> (إعلانات، SEO، استراتيجية محتوى) و<strong class="text-ink">التطوير التقني</strong> (مواقع، تطبيقات، أتمتة بـ n8n). هذا المزيج يسمح لي ببناء مشاريع متكاملة بدون الحاجة لتنسيق بين عدة مزوّدين.
        </p>
        <p>
          أؤمن أن العمل المستقل الجاد لا يقل احترافية عن أي وكالة — بل يتفوّق عليها في الوضوح والمرونة والتواصل المباشر.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-px bg-border">
        <div class="bg-cream p-6 text-center">
          <div class="text-2xl font-light text-navy mb-1">+3</div>
          <div class="text-xs font-light tracking-widest text-ink/50">سنوات خبرة</div>
        </div>
        <div class="bg-cream p-6 text-center">
          <div class="text-2xl font-light text-navy mb-1">+20</div>
          <div class="text-xs font-light tracking-widest text-ink/50">مشروع منجز</div>
        </div>
        <div class="bg-cream p-6 text-center">
          <div class="text-2xl font-light text-navy mb-1">KSA</div>
          <div class="text-xs font-light tracking-widest text-ink/50">السوق السعودي</div>
        </div>
      </div>

      <div class="mt-12">
        <Button href="/contact" variant="primary" size="lg">احجز استشارة مجانية</Button>
      </div>
    </div>
  </section>
</BaseLayout>
