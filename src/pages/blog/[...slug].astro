---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/blog/TableOfContents.tsx';
import { formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth <= 3).map(h => ({ id: h.slug, text: h.text, level: h.depth }));
const categoryLabels: Record<string, string> = { ecommerce: 'تجارة إلكترونية', marketing: 'تسويق', automation: 'أتمتة', seo: 'SEO', general: 'عام' };
---
<BaseLayout title={post.data.title} description={post.data.description} type="article" pubDate={post.data.pubDate} lang="ar" dir="rtl">
  <article class="section-padding">
    <div class="container-site">
      <div class="max-w-2xl mb-12">
        <div class="flex items-center gap-3 mb-6">
          <a href="/blog" class="text-xs text-teal font-light tracking-widest hover:underline">← المدونة</a>
          <span class="text-ink/20">/</span>
          <span class="text-xs text-ink/50 font-light">{categoryLabels[post.data.category] ?? post.data.category}</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-light text-ink leading-snug mb-6 text-balance">{post.data.title}</h1>
        <div class="flex items-center gap-4 text-xs text-ink/50 font-light">
          <span>{post.data.author}</span>
          <span class="w-1 h-1 rounded-full bg-ink/20"></span>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        </div>
        <div class="flex flex-wrap gap-2 mt-4">
          {post.data.tags.map(tag => (<span class="text-xs px-2 py-1 bg-navy/5 text-navy/70 font-light">{tag}</span>))}
        </div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_220px] gap-12">
        <div class="prose-custom max-w-none"><Content /></div>
        <aside class="hidden lg:block"><TableOfContents headings={toc} client:load /></aside>
      </div>
      <div class="mt-16 pt-12 border-t border-border">
        <div class="bg-navy/[0.03] border border-navy/10 p-8 max-w-xl">
          <p class="text-sm font-light text-ink/70 mb-4">هل وجدت هذا المقال مفيداً؟ إذا كنت تريد مساعدة في تطبيق هذه الأفكار على مشروعك —</p>
          <a href="/contact" class="inline-flex items-center px-6 py-3 bg-navy text-cream text-sm font-light tracking-widest hover:bg-navy-dark transition-colors">احجز استشارة مجانية</a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
<style is:global>
.prose-custom h2 { font-size:1.5rem; font-weight:300; color:#0A4D68; margin-top:2.5rem; margin-bottom:1rem; padding-bottom:0.5rem; border-bottom:1px solid #E5E7EB; }
.prose-custom h3 { font-size:1.15rem; font-weight:400; color:#080C10; margin-top:1.75rem; margin-bottom:0.75rem; }
.prose-custom p { font-size:1rem; line-height:1.85; color:rgba(8,12,16,0.8); margin-bottom:1.25rem; font-weight:300; }
.prose-custom ul, .prose-custom ol { margin:1rem 0 1.5rem 0; padding-right:1.5rem; }
.prose-custom li { font-size:0.95rem; line-height:1.8; color:rgba(8,12,16,0.75); margin-bottom:0.5rem; font-weight:300; }
.prose-custom strong { font-weight:500; color:#080C10; }
.prose-custom a { color:#088395; text-decoration:underline; text-underline-offset:3px; }
.prose-custom table { width:100%; border-collapse:collapse; margin:1.5rem 0; font-size:0.875rem; }
.prose-custom th { background:#0A4D68; color:#FAFAF9; padding:0.75rem 1rem; text-align:right; font-weight:300; }
.prose-custom td { padding:0.65rem 1rem; border-bottom:1px solid #E5E7EB; color:rgba(8,12,16,0.75); font-weight:300; }
.prose-custom pre { background:#080C10; color:#05BFDB; padding:1.25rem; font-size:0.85rem; overflow-x:auto; margin:1.5rem 0; }
.prose-custom code { background:rgba(10,77,104,0.08); color:#088395; padding:0.15em 0.4em; font-size:0.875em; }
.prose-custom pre code { background:transparent; color:inherit; padding:0; }
.prose-custom blockquote { border-right:3px solid #088395; padding-right:1.25rem; margin:1.5rem 0; color:rgba(8,12,16,0.6); font-style:italic; }
</style>
