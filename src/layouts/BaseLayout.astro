---
import '../styles/globals.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { buildSEO, buildPersonSchema, buildWebsiteSchema, buildArticleSchema, type SEOProps } from '../lib/seo';

interface Props extends SEOProps {
  dir?: 'rtl' | 'ltr';
  lang?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const { dir = 'rtl', lang = 'ar', hideHeader = false, hideFooter = false, ...seoProps } = Astro.props;
const seo = buildSEO(seoProps);

const personSchema   = buildPersonSchema();
const websiteSchema  = buildWebsiteSchema();
const articleSchema  = seoProps.type === 'article' && seoProps.pubDate
  ? buildArticleSchema(seo.title, seo.description, seoProps.pubDate, seo.canonical)
  : null;
---

<!DOCTYPE html>
<html lang={lang} dir={dir} class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
  <link rel="canonical" href={seo.canonical} />
  {seo.noIndex && <meta name="robots" content="noindex,nofollow" />}

  <meta property="og:type"        content={seo.openGraph.type} />
  <meta property="og:title"       content={seo.openGraph.title} />
  <meta property="og:description" content={seo.openGraph.description} />
  <meta property="og:image"       content={seo.openGraph.image} />
  <meta property="og:site_name"   content={seo.openGraph.siteName} />
  <meta property="og:locale"      content="ar_SA" />

  <meta name="twitter:card"        content={seo.twitter.card} />
  <meta name="twitter:title"       content={seo.twitter.title} />
  <meta name="twitter:description" content={seo.twitter.description} />
  <meta name="twitter:image"       content={seo.twitter.image} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="مدونة أحمد الحربي" href="/rss.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- JSON-LD -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  {articleSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
</head>
<body class="flex flex-col min-h-screen">
  {!hideHeader && <Header />}
  <main class="flex-1">
    <slot />
  </main>
  {!hideFooter && <Footer />}
</body>
</html>
